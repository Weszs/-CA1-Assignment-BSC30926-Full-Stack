<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#f5f4ee" />
    <title>@ViewData["Title"] - Edutots</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <a class="brand" asp-area="" asp-page="/Index" aria-label="Edutots school directory">
            <span class="brand-mark" aria-hidden="true">E</span>
            <span>edutots<span class="brand-period">.</span></span>
        </a>
        <span class="header-label">SCHOOL NETWORK</span>
    </header>
    <main role="main">
            @RenderBody()
    </main>
    <footer class="site-footer">
        <span>Edutots school network</span>
        <span>School directory</span>
    </footer>

    <script src="_framework/blazor.server.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>